# Copy to backend/.env. Everything is optional except SECRET_KEY for real deployments.
#
# The ONLY model this server calls is the router: it reads a question and decides which
# of the student's browser AIs should answer it. It never writes an answer, so these keys
# buy a few tokens per question, not inference. Leave them blank and routing falls back
# to keywords — the product still works.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me

# ---- routing model (all optional; keyword fallback with none) ----
# Any one of these is plenty — routing is a classification job on a tiny free-tier model.
# aistudio.google.com
GOOGLE_API_KEY=
# console.groq.com
GROQ_API_KEY=
# openrouter.ai
OPENROUTER_API_KEY=
# Canned routing decisions, no key and no network. Great for demos and tests.
MOCK_LLM=false
PROVIDER_MIN_INTERVAL_S=1.0

# ---- limits ----
MAX_UPLOAD_MB=15
MAX_QUESTIONS_PER_BANK=200
CLASS_CACHE=true

# ---- billing (the paywall sits on DOCX export only — answering is always free) ----
# Question banks a new account can export before paying. 1 = "try it, then pay".
FREE_BANKS=1

# What a credit costs. 1 credit = 1 question bank = 1 downloadable document.
# Bulk packs exist to cut payment friction, not to discount much: every ₹20 is a
# separate UPI approval, and that friction is what actually loses sales.
CREDIT_PACKS=[{"credits":1,"inr":20,"label":"One bank"},{"credits":6,"inr":99,"label":"Six banks"},{"credits":15,"inr":199,"label":"Semester pack"}]

# Demo/test mode: orders complete instantly, no gateway, no money. Turn OFF for real use.
MOCK_PAYMENTS=true

# Razorpay (dashboard.razorpay.com). Needed only when MOCK_PAYMENTS=false.
#   1. Settings -> API Keys -> generate; paste key id + secret below
#   2. Settings -> Webhooks -> add <your-domain>/api/billing/webhook
#      subscribe to `payment_link.paid`, set a secret, paste it below
# Credits are granted ONLY by that webhook — never by the browser claiming it paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=http://localhost:5173/app

# ---- chrome extension ----
# Lock this to your published extension's real ID before launch:
#   EXTENSION_ORIGIN_REGEX=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
EXTENSION_ORIGIN_REGEX=chrome-extension://[a-z]{32}

# ---- server ----
# The extension's content script must also match this origin — see extension/manifest.json
FRONTEND_ORIGIN=http://localhost:5173
