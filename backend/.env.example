# Copy to backend/.env and fill in. Everything is optional except SECRET_KEY for real deployments.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-change-me

# ---- AI providers (ALL optional — with zero keys the product still works via Assist mode) ----
# Google AI Studio (aistudio.google.com). NOTE: if you reuse the same key as project delta,
# the gemma quota is SHARED between both apps. Prefer a separate key.
GOOGLE_API_KEY=

# Groq (console.groq.com) — free tier, fast Llama models, used for code questions.
GROQ_API_KEY=

# OpenRouter (openrouter.ai) — free-tier models: DeepSeek R1 (numericals), Kimi K2 (graphs/diagrams),
# Qwen coder. Verify current ':free' model IDs at openrouter.ai/models and edit backend/models.json.
OPENROUTER_API_KEY=

# Demo/test mode: canned deterministic answers, no network calls.
MOCK_LLM=false

# ---- limits ----
DAILY_QUESTION_QUOTA=60
MAX_UPLOAD_MB=15
PROVIDER_MIN_INTERVAL_S=4.0
CLASS_CACHE=true

# ---- billing (the paywall sits on DOCX export only — answering is always free) ----
# Question banks a new account can export before paying. 1 = "try it, then pay".
FREE_BANKS=1

# What a credit costs. 1 credit = 1 question bank = 1 downloadable document.
# Bulk packs exist to cut payment friction, not to discount much: every ₹20 is a
# separate UPI approval, and that friction is what actually loses sales.
CREDIT_PACKS=[{"credits":1,"inr":20,"label":"One bank"},{"credits":6,"inr":99,"label":"Six banks"},{"credits":15,"inr":199,"label":"Semester pack"}]

# Demo/test mode: orders complete instantly, no gateway, no money. Turn OFF for real use.
MOCK_PAYMENTS=true

# Razorpay (dashboard.razorpay.com). Needed only when MOCK_PAYMENTS=false.
#   1. Settings -> API Keys -> generate; paste key id + secret below
#   2. Settings -> Webhooks -> add <your-domain>/api/billing/webhook
#      subscribe to `payment_link.paid`, set a secret, paste it below
# Credits are granted ONLY by that webhook — never by the browser claiming it paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_CALLBACK_URL=http://localhost:5173/app

# ---- chrome extension ----
PAIRING_CODE_TTL_S=300
# Lock this to your published extension's real ID before launch:
#   EXTENSION_ORIGIN_REGEX=chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
EXTENSION_ORIGIN_REGEX=chrome-extension://[a-z]{32}

# ---- server ----
FRONTEND_ORIGIN=http://localhost:5173
